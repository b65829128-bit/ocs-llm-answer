# 服务监听地址：自用建议只绑 127.0.0.1
HOST=127.0.0.1
PORT=8787

# LLM 提供方：deepseek | mock
LLM_PROVIDER=deepseek

# DeepSeek 配置（https://platform.deepseek.com / https://api-docs.deepseek.com/zh-cn/）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 当前官方模型：deepseek-flash（多模态、快）、deepseek-v4-pro（纯文本、更强）
DEEPSEEK_MODEL=deepseek-flash

# 按题型路由；留空则使用 DEEPSEEK_MODEL
MODEL_SINGLE=
MODEL_MULTIPLE=
MODEL_JUDGEMENT=
MODEL_COMPLETION=

# 思考模式：默认关闭以控制延迟；难题改成 true
# 开启后 temperature 不生效，并会使用 LLM_REASONING_EFFORT（low | high | max）
LLM_THINKING=false
LLM_REASONING_EFFORT=high

# 请求预算：OCS 侧默认 60 秒硬超时，这里留余量
LLM_TIMEOUT_SECONDS=45
# 非思考模式 2048 足够；开启思考模式建议 4096+
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0
USE_JSON_MODE=true

# 低于该置信度返回空答案（让 OCS 标记未答，而不是瞎猜）
MIN_CONFIDENCE=0.35

# 可选：本地访问令牌；设置后 OCS 配置里要带 Authorization: Bearer <token>
API_TOKEN=

# SQLite 缓存/日志
DB_PATH=data/ocs_llm.db
CACHE_TTL_SECONDS=604800

# CORS：自用可保持 *；如果只给固定页面用，改成逗号分隔的 origin
CORS_ORIGINS=*
LOG_LEVEL=INFO
